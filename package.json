{
  "name": "wattometro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "pwa-assets-generator",
    "dev:server": "wrangler dev -c server/wrangler.toml",
    "db:migrate:local": "wrangler d1 migrations apply wattometro --local -c server/wrangler.toml",
    "db:migrate:remote": "wrangler d1 migrations apply wattometro --remote -c server/wrangler.toml",
    "deploy:app": "pnpm build && wrangler deploy -c wrangler.app.toml",
    "deploy:server": "wrangler deploy -c server/wrangler.toml",
    "user:create": "tsx scripts/create-user.ts",
    "erse:sync": "tsx scripts/erse-sync.ts",
    "omie:sync": "tsx scripts/omie-sync.ts",
    "ml:backtest": "tsx scripts/ml-backtest.ts",
    "ml:anomalies": "tsx scripts/ml-anomalies.ts",
    "ai:eval": "tsx scripts/ai-eval.ts",
    "nilm:eval": "tsx scripts/nilm-eval.ts",
    "shelly:install": "tsx scripts/shelly-install.ts",
    "shelly:backfill": "tsx scripts/shelly-backfill.ts"
  },
  "packageManager": "pnpm@12.11.2",
  "license": "AGPL-3.0-or-later",
  "author": "Paulo Barbosa",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "hono": "^4.13.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.151.3"
  }
}
