# Copy to .env (ignored by Git) and fill in. Local tools only: Vite exposes
# just VITE_* variables to the app, so these never reach the browser.

# The Shelly on the home network (shelly/README.md), for installing or
# updating shelly/wattometro.js from this computer.
# IP address on the home network (in the Shelly app: device information), e.g. 192.168.1.50
SHELLY_HOST=
# Settings → Authentication on the Shelly's web page (user is always "admin").
SHELLY_PASSWORD=
