# Copy to .env (ignored by Git) and fill in. Local tools only: Vite exposes
# just VITE_* variables to the app, so these never reach the browser.

# The Shelly on the home network (shelly/README.md), for installing or
# updating shelly/wattometro.js from this computer.
# IP address on the home network (in the Shelly app: device information), e.g. 192.168.1.50
SHELLY_HOST=
# Settings → Authentication on the Shelly's web page (user is always "admin").
SHELLY_PASSWORD=
# Optional: pnpm shelly:install writes these to the Shelly's KVS when they are
# missing (e.g. after a power cut emptied it). The token is the device's, from
# Definições → Dispositivos (shown once); keep it only here and on the Shelly.
SHELLY_INGEST_URL=https://app.wattometro.workers.dev/v1/ingest
SHELLY_DEVICE_TOKEN=

# Only for pnpm ai:eval (questions to the AI on fixtures/private; spends money).
# The app never reads it: each user pastes their own key in Definições.
ANTHROPIC_API_KEY=
